# Dependencies
node_modules/
npm-debug.log*
.npm/

# Local research notes — never published. The repository names no source
# anywhere on purpose; these files keep that record out of git rather than
# losing it. Continuous integration fails if either is ever tracked.
SOURCES.md
PRIVATE-NOTES.md

# Generated skill link directory (created by scripts/link-local.sh)
.claude/skills/

# Deliberately NOT ignored: .markdownlint* config files. Default rules are a
# hard constraint here, and the build fails if such a file exists. Ignoring
# them would hide an accidental config instead of catching it.

# Written by the Erlang VM if it dies while validate-examples.mjs is
# parsing the Elixir examples under --with-elixir.
erl_crash.dump

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp
