{
  "name": "functional-design-skills",
  "version": "3.0.3",
  "description": "Agent Skills carrying design rules for codebases written in a functional style, for Claude Code",
  "license": "MIT",
  "author": "Yutthana Siphuengchai",
  "homepage": "https://github.com/yutna/functional-design-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutna/functional-design-skills.git"
  },
  "keywords": [
    "functional-programming",
    "software-design",
    "domain-modelling",
    "type-driven-design",
    "agent-skills",
    "claude-code",
    "refactoring"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#SOURCES.md\" \"#PRIVATE-NOTES.md\" \"#.claude\"",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:prose": "node scripts/validate-prose.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "validate:rules": "node scripts/validate-rules.mjs",
    "validate:counts": "node scripts/validate-counts.mjs",
    "eval:routing": "node scripts/eval-routing.mjs",
    "eval:scenarios": "node scripts/eval-scenarios.mjs",
    "eval:plugin": "node scripts/eval-plugin.mjs",
    "test": "npm run lint:md && npm run validate:skills && npm run validate:prose && npm run validate:examples && npm run validate:rules && npm run validate:counts && npm run eval:routing",
    "test:guards": "node scripts/validate-prose.mjs --selftest && node scripts/validate-examples.mjs --selftest && node scripts/negative-test.mjs && node scripts/eval-plugin.mjs --selftest"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@types/react": "19.3.0",
    "effect": "3.22.2",
    "immer": "11.1.21",
    "markdownlint-cli2": "0.23.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "ts-pattern": "5.9.0",
    "typescript": "5.9.3",
    "valibot": "1.5.0",
    "xstate": "5.33.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
